Grammar

    0 $accept: program $end

    1 program: external_list

    2 external_list: external_list external
    3              | external

    4 external: declaration
    5         | statement

    6 declaration: type_specifier init_declarator_list ';'

    7 type_specifier: KW_INT
    8               | KW_FLOAT
    9               | KW_CHAR
   10               | KW_VOID
   11               | KW_STRUCT IDENTIFIER

   12 init_declarator_list: init_declarator_list ',' init_declarator
   13                     | init_declarator

   14 init_declarator: IDENTIFIER
   15                | IDENTIFIER ASSIGN expression

   16 statement: compound_statement
   17          | expression_statement
   18          | selection_statement
   19          | iteration_statement
   20          | jump_statement

   21 compound_statement: '{' statement_list_opt '}'

   22 statement_list_opt: statement_list
   23                   | /* empty */

   24 statement_list: statement_list statement
   25               | statement

   26 expression_statement: ';'
   27                     | expression ';'

   28 selection_statement: KW_IF '(' expression ')' statement
   29                    | KW_IF '(' expression ')' statement KW_ELSE statement

   30 iteration_statement: KW_WHILE '(' expression ')' statement
   31                    | KW_FOR '(' expression_statement expression_statement expression_opt ')' statement

   32 expression_opt: expression
   33               | /* empty */

   34 jump_statement: KW_RETURN expression_opt ';'
   35               | KW_BREAK ';'
   36               | KW_CONTINUE ';'

   37 expression: assignment_expression

   38 assignment_expression: logical_or_expression
   39                      | IDENTIFIER ASSIGN assignment_expression

   40 logical_or_expression: logical_or_expression OR logical_and_expression
   41                      | logical_and_expression

   42 logical_and_expression: logical_and_expression AND equality_expression
   43                       | equality_expression

   44 equality_expression: equality_expression EQ relational_expression
   45                    | equality_expression NE relational_expression
   46                    | relational_expression

   47 relational_expression: relational_expression LT additive_expression
   48                      | relational_expression LE additive_expression
   49                      | relational_expression GT additive_expression
   50                      | relational_expression GE additive_expression
   51                      | additive_expression

   52 additive_expression: additive_expression '+' multiplicative_expression
   53                    | additive_expression '-' multiplicative_expression
   54                    | multiplicative_expression

   55 multiplicative_expression: multiplicative_expression '*' unary_expression
   56                          | multiplicative_expression '/' unary_expression
   57                          | multiplicative_expression '%' unary_expression
   58                          | unary_expression

   59 unary_expression: primary_expression
   60                 | '-' unary_expression
   61                 | NOT unary_expression

   62 primary_expression: IDENTIFIER
   63                   | INT_CONST
   64                   | FLOAT_CONST
   65                   | STRING_LITERAL
   66                   | CHAR_LITERAL
   67                   | '(' expression ')'


